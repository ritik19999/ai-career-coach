# Frontend build
FROM node:20-alpine as frontend-builder

WORKDIR /app
COPY ./Frontend .

RUN npm ci
RUN npm run build

# Backend
FROM node:20-alpine

WORKDIR /app
COPY ./Backend .

RUN npm ci --only=production

# Copy frontend build
COPY --from=frontend-builder /app/dist /app/public

EXPOSE 3000

CMD ["node", "server.js"]